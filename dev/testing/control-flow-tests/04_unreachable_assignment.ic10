# ============================================================
# TEST 4: Unreachable assignments - subtle true positives
# ============================================================
# A register's ONLY assignment lives in a block that can never run before
# the read (skipped by an unconditional jump and never fallen-through to).
# The CFG must still flag the read, because no real execution path assigns
# the value first.
#
# PASS = a red ERROR on the lines marked # ERROR (and only those).
# Note: yellow "assigned but never read" warnings on r6/r8/r10 are a
# SEPARATE, unrelated diagnostic and are expected here - ignore them.

j main               # always jump straight to main

dead_setup:
move r5 9            # this block is jumped over and never reached
hcf                  # ...and it halts, so it never falls into main
main:
add r6 r5 1          # ERROR: r5 only assigned in unreachable block

# r7 below is genuinely fine: assigned on the path before its read.
move r7 3
add r8 r7 1          # no error: r7 assigned above

# r9 is assigned only AFTER its read, with no loop bringing control back.
add r10 r9 1         # ERROR: r9 read before assigned
move r9 7
