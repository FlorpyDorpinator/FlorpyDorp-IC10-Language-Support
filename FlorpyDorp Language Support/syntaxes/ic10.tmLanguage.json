{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ic10",
  "scopeName": "source.ic10",
  "fileTypes": [
    "ic10"
  ],
  "patterns": [
    {
      "include": "#label"
    },
    {
      "include": "#instruction"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#whitespace"
    },
    {
      "include": "#newline"
    }
  ],
  "repository": {
    "instruction": {
      "patterns": [
        {
          "name": "entity.name.function.ic10",
          "match": "^\\s*(?i:(bapzal|bdnsal|bdseal|beqzal|bgezal|bgtzal|blezal|bltzal|bnazal|bnezal|define|select|alias|atan2|bapal|bdnvl|bdnvs|beqal|bgeal|bgtal|bleal|bltal|bnaal|bneal|brapz|brdns|brdse|breqz|brgez|brgtz|brlez|brltz|brnan|brnaz|brnez|clamp|floor|label|round|sleep|snanz|trunc|yield|acos|asin|atan|bapz|bdns|bdse|beqz|bgez|bgtz|blez|bltz|bnan|bnaz|bnez|brap|breq|brge|brgt|brle|brlt|brna|brne|ceil|clrd|getd|lbns|lerp|move|peek|poke|push|putd|rand|rmap|sapz|sdns|sdse|seqz|sgez|sgtz|slez|sltz|snan|snaz|snez|sqrt|abs|add|and|bap|beq|bge|bgt|ble|blt|bna|bne|clr|cos|div|exp|ext|get|hcf|ins|jal|lbn|lbs|log|max|min|mod|mul|nor|not|pop|pow|put|rol|ror|sap|sbn|sbs|seq|sge|sgn|sgt|sin|sla|sle|sll|slt|sna|sne|sra|srl|sub|tan|xor|jr|lb|ld|lr|ls|or|sb|sd|ss|j|l|s))\\b"
        },
        {
          "begin": "(?<=\\S)\\s+",
          "end": "(?=$|\\s|[#\\r\\n])",
          "patterns": [
            {
              "include": "#whitespace"
            },
            {
              "include": "#operand"
            }
          ]
        }
      ]
    },
    "label": {
      "patterns": [
        {
          "match": "([a-zA-Z_.][a-zA-Z0-9_.]*)(:)",
          "captures": {
            "1": {
              "name": "entity.name.label.ic10"
            },
            "2": {
              "name": "punctuation.separator.label.ic10"
            }
          }
        }
      ]
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.line.number-sign.ic10",
          "match": "#.*"
        }
      ]
    },
    "operand": {
      "patterns": [
        {
          "include": "#hash-function"
        },
        {
          "include": "#str-function"
        },
        {
          "include": "#qualified-enum"
        },
        {
          "include": "#register"
        },
        {
          "include": "#device"
        },
        {
          "include": "#number"
        },
        {
          "include": "#logictype"
        },
        {
          "name": "variable.other.ic10",
          "match": "\\b[a-zA-Z_.][a-zA-Z0-9_.]*\\b"
        }
      ]
    },
    "hash-function": {
      "begin": "(?i)(HASH)(\\s*)(\\()",
      "end": "(\\))",
      "beginCaptures": {
        "1": {
          "name": "support.function.builtin.ic10"
        },
        "3": {
          "name": "support.function.builtin.ic10"
        }
      },
      "endCaptures": {
        "1": {
          "name": "support.function.builtin.ic10"
        }
      },
      "patterns": [
        {
          "name": "variable.other.ic10",
          "match": "\"[^\"]*\""
        },
        {
          "name": "variable.other.ic10",
          "match": "[^\\)\\s]+"
        }
      ]
    },
    "str-function": {
      "begin": "(?i)(STR)(\\s*)(\\()",
      "end": "(\\))",
      "beginCaptures": {
        "1": {
          "name": "support.function.builtin.ic10"
        },
        "3": {
          "name": "support.function.builtin.ic10"
        }
      },
      "endCaptures": {
        "1": {
          "name": "support.function.builtin.ic10"
        }
      },
      "patterns": [
        {
          "name": "variable.other.ic10",
          "match": "\"[^\"]*\""
        },
        {
          "name": "variable.other.ic10",
          "match": "[^\\)\\s]+"
        }
      ]
    },
    "qualified-enum": {
      "patterns": [
        {
          "name": "constant.language.enum.ic10",
          "match": "\\b[A-Z][a-zA-Z0-9]*\\.[A-Z][a-zA-Z0-9]*\\b"
        }
      ]
    },
    "register": {
      "patterns": [
        {
          "name": "variable.parameter.register.ic10",
          "match": "\\b(ra|sp|r+(?:[0-9]|1[0-5]))\\b"
        }
      ]
    },
    "device": {
      "patterns": [
        {
          "name": "variable.language.device.ic10",
          "match": "\\b(d[b0-5]|d[r0-9]|d[r1][0-5])\\b"
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.ic10",
          "match": "\\b-?[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "logictype": {
      "patterns": [
        {
          "name": "support.type.logic.ic10",
          "match": "\\b(RatioLiquidHydrochloricAcidOutput2|RatioLiquidHydrochloricAcidInput2|RatioLiquidHydrochloricAcidOutput|TemperatureDifferentialEfficiency|OperationalTemperatureEfficiency|RatioLiquidHydrochloricAcidInput|RatioLiquidSodiumChlorideOutput2|RatioLiquidCarbonDioxideOutput2|RatioLiquidSodiumChlorideInput2|RatioLiquidSodiumChlorideOutput|RatioLiquidCarbonDioxideInput2|RatioLiquidCarbonDioxideOutput|RatioLiquidNitrousOxideOutput2|RatioLiquidSodiumChlorideInput|RatioLiquidCarbonDioxideInput|RatioLiquidNitrousOxideInput2|RatioLiquidNitrousOxideOutput|RatioHydrochloricAcidOutput2|RatioLiquidNitrousOxideInput|RatioHydrochloricAcidInput2|RatioHydrochloricAcidOutput|RatioLiquidHydrazineOutput2|RatioLiquidHydrochloricAcid|RatioLiquidPollutantOutput2|RatioHydrochloricAcidInput|RatioLiquidHydrazineInput2|RatioLiquidHydrazineOutput|RatioLiquidHydrogenOutput2|RatioLiquidNitrogenOutput2|RatioLiquidPollutantInput2|RatioLiquidPollutantOutput|ManualResearchRequiredPod|RatioCarbonDioxideOutput2|RatioLiquidAlcoholOutput2|RatioLiquidHydrazineInput|RatioLiquidHydrogenInput2|RatioLiquidHydrogenOutput|RatioLiquidMethaneOutput2|RatioLiquidNitrogenInput2|RatioLiquidNitrogenOutput|RatioLiquidPollutantInput|RatioLiquidSilanolOutput2|RatioLiquidSodiumChloride|RatioPollutedWaterOutput2|RatioCarbonDioxideInput2|RatioCarbonDioxideOutput|RatioLiquidAlcoholInput2|RatioLiquidAlcoholOutput|RatioLiquidCarbonDioxide|RatioLiquidHydrogenInput|RatioLiquidMethaneInput2|RatioLiquidMethaneOutput|RatioLiquidNitrogenInput|RatioLiquidOxygenOutput2|RatioLiquidSilanolInput2|RatioLiquidSilanolOutput|RatioNitrousOxideOutput2|RatioPollutedWaterInput2|RatioPollutedWaterOutput|RatioCarbonDioxideInput|RatioLiquidAlcoholInput|RatioLiquidMethaneInput|RatioLiquidNitrousOxide|RatioLiquidOxygenInput2|RatioLiquidOxygenOutput|RatioLiquidOzoneOutput2|RatioLiquidSilanolInput|RatioNitrousOxideInput2|RatioNitrousOxideOutput|RatioPollutedWaterInput|CurrentResearchPodType|RatioLiquidOxygenInput|RatioLiquidOzoneInput2|RatioLiquidOzoneOutput|RatioNitrousOxideInput|EnvironmentEfficiency|InterrogationProgress|MinimumWattsToContact|RatioHydrazineOutput2|RatioHydrochloricAcid|RatioLiquidOzoneInput|RatioPollutantOutput2|NextWeatherEventTime|RatioHydrazineInput2|RatioHydrazineOutput|RatioHydrogenOutput2|RatioLiquidHydrazine|RatioLiquidPollutant|RatioNitrogenOutput2|RatioPollutantInput2|RatioPollutantOutput|WattsReachingContact|WorkingGasEfficiency|CelestialParentHash|MineablesInVicinity|RatioHydrazineInput|RatioHydrogenInput2|RatioHydrogenOutput|RatioLiquidHydrogen|RatioLiquidNitrogen|RatioMethaneOutput2|RatioNitrogenInput2|RatioNitrogenOutput|RatioPollutantInput|RatioSilanolOutput2|TemperatureExternal|PressureEfficiency|RatioCarbonDioxide|RatioHeliumOutput2|RatioHydrogenInput|RatioLiquidAlcohol|RatioLiquidMethane|RatioLiquidSilanol|RatioMethaneInput2|RatioMethaneOutput|RatioNitrogenInput|RatioOxygenOutput2|RatioPollutedWater|RatioSilanolInput2|RatioSilanolOutput|TemperatureOutput2|TemperatureSetting|BestContactFilter|BurnTimeRemaining|CombustionLimiter|CombustionOutput2|FlightControlRule|RatioHeliumInput2|RatioHeliumOutput|RatioLiquidOxygen|RatioMethaneInput|RatioNitrousOxide|RatioOxygenInput2|RatioOxygenOutput|RatioOzoneOutput2|RatioSilanolInput|RatioSteamOutput2|RatioWaterOutput2|TemperatureInput2|TemperatureOutput|TimeToDestination|TotalMolesOutput2|VelocityMagnitude|VelocityRelativeX|VelocityRelativeY|VelocityRelativeZ|ChartedNavPoints|CollectableGoods|CombustionInput2|CombustionOutput|ContactSlotIndex|MineablesInQueue|PressureExternal|PressureInternal|ProportionalGain|RatioHeliumInput|RatioLiquidOzone|RatioOxygenInput|RatioOzoneInput2|RatioOzoneOutput|RatioSteamInput2|RatioSteamOutput|RatioWaterInput2|RatioWaterOutput|TargetPrefabHash|TemperatureInput|TotalMolesInput2|TotalMolesOutput|CombustionInput|CompletionRatio|CurrentNodeType|DestinationCode|ExhaustVelocity|HorizontalRatio|NextWeatherHash|PowerGeneration|PressureOutput2|PressureSetting|RatioOzoneInput|RatioSteamInput|RatioWaterInput|ReEntryAltitude|SolarIrradiance|TargetSlotIndex|TotalMolesInput|AlignmentError|DerivativeGain|DrillCondition|PowerPotential|PressureInput2|PressureOutput|RatioHydrazine|RatioPollutant|ReturnFuelCost|SignalStrength|TargetNodeType|TargetPadIndex|ThrustToWeight|VolumeOfLiquid|CelestialHash|ContactTypeId|ElevatorLevel|ElevatorSpeed|HarvestedHash|MaturityRatio|MinedQuantity|PowerRequired|PressureInput|PressureWaste|RatioHydrogen|RatioNitrogen|RequiredPower|SemiMajorAxis|SettingOutput|TotalQuantity|VerticalRatio|Acceleration|Eccentricity|HealthDamage|IntegralGain|NetworkFault|OccupantHash|RatioMethane|RatioSilanol|SeedingRatio|SettingInput|SortingClass|AutoShutOff|ChargeRatio|ClearMemory|CurrentCode|EntityState|ExportCount|ImportCount|Inclination|MaxQuantity|OrbitPeriod|Orientation|PassedMoles|PowerActual|PressureAir|RatioHelium|RatioOxygen|ReferenceId|RequestHash|Temperature|TrueAnomaly|AirRelease|Combustion|DistanceAu|DistanceKm|Efficiency|FilterType|Filtration|ForceWrite|Horizontal|LineNumber|PrefabHash|RatioOzone|RatioSteam|RatioWater|RecipeHash|SolarAngle|SoundAlert|StunDamage|TotalMoles|TotalSlots|FreeSlots|NavPoints|PositionX|PositionY|PositionZ|StackSize|VelocityX|VelocityY|VelocityZ|Activate|Altitude|AutoLand|Channel0|Channel1|Channel2|Channel3|Channel4|Channel5|Channel6|Channel7|Discover|Extended|ForwardX|ForwardY|ForwardZ|NameHash|Occupied|Pressure|Progress|Quantity|Reagents|Richness|Setpoint|SignalID|Throttle|Vertical|Average|Density|DryMass|Harvest|Maximum|Minimum|Seeding|Setting|TargetX|TargetY|TargetZ|Charge|Damage|Growth|Health|Mature|Output|Stress|Survey|Thrust|Volume|Weight|Chart|Class|Color|Count|Error|Flush|Index|Plant|Power|Ratio|Reset|Sites|SizeX|SizeY|SizeZ|Apex|Fuel|Idle|Lock|Mass|Mode|None|Open|Size|Time|Bpm|Rpm|Sum|On)\\b"
        }
      ]
    },
    "whitespace": {
      "patterns": [
        {
          "name": "meta.whitespace.ic10",
          "match": "\\s+"
        }
      ]
    },
    "newline": {
      "patterns": [
        {
          "name": "constant.character.escape.ic10",
          "match": "\\\\r\\\\n"
        },
        {
          "name": "constant.character.escape.ic10",
          "match": "\\\\r"
        },
        {
          "name": "constant.character.escape.ic10",
          "match": "\\\\n"
        }
      ]
    }
  }
}
